{
  "name": "flydesk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "多租戶白標訂票 SaaS：後台設定驅動每個使用者的前台呈現",
  "scripts": {
    "dev": "vite dev --port 4310",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cf:types": "cf workers types",
    "d1:schema": "wrangler d1 execute flydesk --remote --file=./migrations/0001_init.sql",
    "d1:schema:local": "wrangler d1 execute flydesk --local --file=./migrations/0001_init.sql",
    "d1:seed": "node scripts/seed-d1.mjs",
    "d1:migration": "node scripts/generate-migration.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.4",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.31",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "fflate": "^0.8.2"
  }
}
